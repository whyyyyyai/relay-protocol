# -----------------------------------------------------------------------------
# SECTION 2: Running commands and talking to Hyprland (the window manager)
# `hyprctl` is Hyprland's command-line tool. "dispatch" tells it to do
# something (focus a window, press a key); "clients" lists every window.
# -----------------------------------------------------------------------------

def run(args, timeout=3, input_bytes=None, check=False):
    """Run a command and capture its output. Returns subprocess.CompletedProcess.

    timeout: give up after this many seconds (raises TimeoutExpired).
    check:   if True, raise an error when the command fails.
    """
    return subprocess.run(
        args,
        input=input_bytes,
        capture_output=True,
        timeout=timeout,
        check=check,
    )


def dispatch(expr):
    """Tell Hyprland to do something, e.g. focus a window or press a key.

    `expr` is a Hyprland Lua expression such as
    'hl.dsp.focus({ window = "address:0x1234" })'. Raises RuntimeError if
    Hyprland reports a failure.
    """
    result = run(["hyprctl", "dispatch", expr])
    text = ((result.stdout or b"") + (result.stderr or b"")).decode().strip()
    if result.returncode != 0:
        raise RuntimeError(text or f"hyprctl dispatch failed ({result.returncode})")
    return text


def clients():
    """Return every open window as a list of dicts (from `hyprctl clients -j`)."""
    return json.loads(run(["hyprctl", "clients", "-j"], check=True).stdout)


def active_address():
    """Return the address of the window that currently has keyboard focus."""
    data = json.loads(run(["hyprctl", "activewindow", "-j"], check=True).stdout)
    return data.get("address") or ""


# -----------------------------------------------------------------------------
# SECTION 3: Working out which agent a window or process belongs to
# Hyprland tells us each window's process id (pid). We then look in /proc
# (Linux's live list of running programs) at that process and its child
# processes to find "grok", "codex" or "claude" in a command line.
# -----------------------------------------------------------------------------

def cmdline(pid):
    """Return the full command line of process `pid` as one string.

    Linux stores it in /proc/<pid>/cmdline with NUL bytes between the words.
    Returns "" if the process has gone away.
    """
    try:
        raw = open(f"/proc/{pid}/cmdline", "rb").read()
    except OSError:
        return ""
    return raw.replace(b"\0", b" ").decode("utf-8", "replace")


def command_agent(text):
    """The agent a process is, ignoring --to and --from arguments."""
    skip = False
    for part in text.split():
        if skip:
            skip = False
            continue
        if part in ("--to", "--from"):
            skip = True
            continue
        base = os.path.basename(part)
        if base == "claude" and "OMARCHY_AGENT_CLAUDE_HOME" in text:
            return "foot-claude"
        if base in ("grok", "codex", "claude"):
            return base
    return None


def agent_of(pid):
    """Which agent (grok/codex/claude/foot-claude) process `pid` is, or None."""
    return command_agent(cmdline(pid))


def process_index():
    """Take a snapshot of every running process.

    Returns two dicts:
      children: parent pid -> list of its child pids
      texts:    pid -> that process's command line
    Used to search down from a window's process to find the agent in it.
    """
    children = {}
    texts = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        try:
            status = open(f"/proc/{pid}/status").read()
            raw = open(f"/proc/{pid}/cmdline", "rb").read()
        except OSError:
            continue
        ppid = 0
        for line in status.splitlines():
            if line.startswith("PPid:"):
                ppid = int(line.split()[1])
                break
        children.setdefault(ppid, []).append(pid)
        texts[pid] = raw.replace(b"\0", b" ").decode("utf-8", "replace")
    return children, texts


def agent_in_tree(root, children, texts):
    """Search a window's process and its descendants for an agent.

    A terminal window's own process is the terminal (e.g. alacritty); the
    agent is a child or grandchild of it. Breadth-first search, stopping
    after 40 processes so it can never run away.
    """
    queue = [root]
    seen = set()
    while queue:
        pid = queue.pop(0)
        if pid in seen:
            continue
        seen.add(pid)
        name = command_agent(texts.get(pid, ""))
        if name:
            return name
        if len(seen) > 40:
            break
        queue.extend(children.get(pid, ()))
    return None


def ancestors():
    """Return the set of pids from this process up through its parents.

    Used to work out who is SENDING: if relay-protocol was run by Codex,
    Codex is one of our ancestors, and so is Codex's terminal window.
    """
    pid = os.getpid()
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        try:
            status = open(f"/proc/{pid}/status").read()
        except OSError:
            break
        ppid = 0
        for line in status.splitlines():
            if line.startswith("PPid:"):
                ppid = int(line.split()[1])
                break
        pid = ppid
    return seen


def agent_windows():
    """Return every open window that belongs to an agent.

    Each item is Hyprland's window dict with one extra key, "agent", set to
    "grok", "codex", "claude", "foot-claude" or "grok-bot". Windows that
    are not agents (browsers etc.) are left out.
    """
    children, texts = process_index()
    found = []
    for client in clients():
        klass = client.get("class") or ""
        pid = client.get("pid") or 0
        if klass == "grok-bot":
            name = "grok-bot"
        else:
            # The foot window's own command line carries OMARCHY_AGENT_CLAUDE_HOME.
            # Claude Code in another terminal does not, even if a child process does.
            name = agent_in_tree(pid, children, texts)
        if not name:
            continue
        item = dict(client)
        item["agent"] = name
        found.append(item)
    return found


# -----------------------------------------------------------------------------
# SECTION 4: Choosing which window(s) should receive a note
# A "window" here is a dict from `hyprctl clients -j`, plus an "agent" key
# added by agent_windows(). Windows on a normal desktop are preferred over
# ones hidden on a "special" workspace such as the scratchpad.
# -----------------------------------------------------------------------------

def workspace_label(window):
    """Name of the workspace a window is on, e.g. '2' or 'special:scratchpad'."""
    ws = window.get("workspace") or {}
    if ws.get("name"):
        return str(ws["name"])
    ident = ws.get("id")
    return "" if ident is None else str(ident)


def is_special(window):
    """True if the window is on a hidden 'special' workspace such as the scratchpad."""
    return workspace_label(window).startswith("special")


def self_window_of(windows, self_pids):
    """The window that belongs to the sender (one of `self_pids`), or None."""
    return next((w for w in windows if w.get("pid") in self_pids), None)


def without(windows, skip):
    """Return `windows` with the window `skip` removed (by address)."""
    if skip is None:
        return list(windows)
    address = skip.get("address")
    return [w for w in windows if w.get("address") != address]


def account_bot_pid():
    """Pid of the signed-in Grok Bot, from its profile lock."""
    lock = Path.home() / ".config" / "Grok Bot" / "SingletonLock"
    try:
        target = os.readlink(lock)
    except OSError:
        return None
    pid = target.rsplit("-", 1)[-1]
    return int(pid) if pid.isdigit() else None


def separate_profile(window):
    """True if this Grok Bot window is a second, separate profile.

    Only the signed-in profile should receive notes; another profile may be
    stuck on a terms-of-service screen and would swallow the message.
    """
    home = account_bot_pid()
    if home is None:
        return False
    return window.get("pid") != home


def pick_grok_bot(windows):
    """Choose the single best Grok Bot window to type into.

    Preference order: the signed-in profile, then one on a normal (not
    hidden) desktop, then one that is not fullscreen. Returns a list with
    at most one window.
    """
    bots = [w for w in windows if w.get("agent") == "grok-bot"]
    # A second profile can sit on a terms screen and must not eat the note.
    home = [w for w in bots if not separate_profile(w)] or bots
    normal = [w for w in home if not is_special(w)] or home
    quiet = [w for w in normal if not w.get("fullscreen")]
    if quiet:
        return [quiet[0]]
    return normal[:1]


def pick_terminal(windows, name):
    """All windows for agent `name`, preferring ones on a normal desktop.

    Falls back to windows on hidden workspaces (like the scratchpad) if
    there are no others.
    """
    matches = [w for w in windows if w.get("agent") == name]
    normal = [w for w in matches if not is_special(w)]
    return normal or matches


def targets_for(windows, explicit):
    """Windows that should receive a typed note for this seat."""
    if explicit in BOTS:
        chosen = pick_grok_bot(windows)
        if not chosen:
            raise SystemExit("no Grok Bot window is open")
        return chosen
    if explicit in TERMINAL_AGENTS:
        chosen = pick_terminal(windows, explicit)
        if not chosen:
            raise SystemExit(f"no {explicit} window is open")
        return chosen
    raise SystemExit(WHICH)


def room_windows(windows, origin, self_window=None):
    """Every open seat except the sender's own window.

    A second window of the same agent still gets the note. From the host
    service there is no self window, so the sender's agent is skipped whole.
    """
    chosen = []
    for name in TERMINAL_AGENTS:
        if self_window is None and name == origin:
            continue
        for window in pick_terminal(windows, name):
            if self_window and window.get("address") == self_window.get("address"):
                continue
            chosen.append(window)
    if origin not in BOTS:
        chosen.extend(pick_grok_bot(windows))
    return chosen


def choose_target(windows, self_pids, explicit):
    """Decide who receives a message when sending from the host.

    Returns (sender's own window or None, list of target windows).
      - With --to: that seat's window(s), never the sender's own window.
      - Without --to, from Grok or Codex: the other one of the pair.
      - Otherwise: only works if exactly one other agent window is open;
        if there is any doubt it stops and asks you to say --to.
    """
    self_window = self_window_of(windows, self_pids)
    if explicit:
        return self_window, without(targets_for(windows, explicit), self_window) or targets_for(windows, explicit)
    origin = (self_window or {}).get("agent") or self_agent(self_pids) or ""
    partner = PAIR.get(origin)
    if partner:
        matches = without(pick_terminal(windows, partner), self_window)
        if not matches:
            raise SystemExit(f"no {partner} window is open")
        return self_window, matches
    others = without(windows, self_window)
    if self_window is not None:
        others = [w for w in others if w.get("agent") != self_window.get("agent")] or others
    if len(others) != 1:
        raise SystemExit(WHICH)
    return self_window, others


# -----------------------------------------------------------------------------
# SECTION 5: Typing into a window - focus, key presses, clipboard, and
# reading the screen to check nobody is mid-sentence in the prompt box
# -----------------------------------------------------------------------------

def is_busy(title):
    """True if the window title starts with a spinner character.

    Agents show a braille "spinner" (Unicode U+2800 to U+28FF) in their
    title while they are working.
    """
    return bool(title) and 0x2800 <= ord(title[0]) <= 0x28FF


def submit_key(agent, title, mode):
    """Which key sends the pasted message: "Return" or "Tab".

    mode "enter"/"tab" forces that key. In "auto" mode Codex gets Tab while
    it is busy, which queues the message for after its current task
    instead of interrupting it. Everyone else gets Enter.
    """
    if mode == "enter":
        return "Return"
    if mode == "tab":
        return "Tab"
    if agent == "codex" and is_busy(title):
        return "Tab"
    return "Return"


def focus(address):
    """Give keyboard focus to the window at `address`, and wait until it has it.

    Waits up to about 0.6 seconds; raises RuntimeError if focus did not move,
    so we never paste into the wrong window.
    """
    if not ADDRESS.fullmatch(address):
        raise RuntimeError(f"refusing odd window address {address!r}")
    dispatch('hl.dsp.focus({ window = "address:' + address + '" })')
    for _ in range(15):
        if active_address() == address:
            return
        time.sleep(0.04)
    raise RuntimeError(f"focus stayed on {active_address()}, not {address}")


def tap(mods, key):
    """Press and release one key, e.g. tap("CTRL SHIFT", "V") for paste.

    Key and modifier names are checked against a strict pattern before
    being sent to Hyprland.
    """
    if not re.fullmatch(r"[A-Za-z0-9_]+", key):
        raise RuntimeError(f"refusing odd key {key!r}")
    if mods and not re.fullmatch(r"[A-Z ]+", mods):
        raise RuntimeError(f"refusing odd mods {mods!r}")
    for state in ("down", "up"):
        dispatch(
            "hl.dsp.send_key_state({ "
            + f'mods = "{mods}", key = "{key}", state = "{state}"'
            + " })"
        )
        time.sleep(0.05)


def copy_text(payload):
    """Put `payload` (bytes) on the clipboard with wl-copy.

    Returns the wl-copy process if it is still running (it stays alive to
    serve the clipboard), so the caller can stop it afterwards.
    """
    proc = subprocess.Popen(
        ["wl-copy", "--type", "text/plain", "--trim-newline"],
        stdin=subprocess.PIPE,
    )
    proc.stdin.write(payload)
    proc.stdin.close()
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        return proc
    return None


def clipboard_snapshot():
    """Return the current clipboard text (bytes), or None if empty/unreadable."""
    listed = run(["wl-paste", "--list-types"], timeout=1)
    if listed.returncode != 0:
        return None
    pasted = run(["wl-paste", "--type", "text/plain"], timeout=1)
    if pasted.returncode != 0:
        return None
    return pasted.stdout


def restore_clipboard(payload):
    """Put back the clipboard saved by clipboard_snapshot() (or clear it if it was empty)."""
    if payload is None:
        proc = subprocess.Popen(["wl-copy", "--clear"])
    else:
        proc = subprocess.Popen(["wl-copy", "--type", "text/plain"], stdin=subprocess.PIPE)
        proc.stdin.write(payload)
        proc.stdin.close()
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        pass


def composer_text(window):
    """Read the bottom 230 pixels of a window as text, using a screenshot.

    Tools: grim (screenshot), ffmpeg (crop), tesseract (OCR, turns pixels
    into text). That area is where the agent's prompt box ("composer")
    is. Returns None if ffmpeg or tesseract is not installed.
    """
    if not shutil_which("tesseract") or not shutil_which("ffmpeg"):
        return None
    x, y = window["at"]
    width, height = window["size"]
    with tempfile.TemporaryDirectory(prefix="relay-protocol-") as tmp:
        full = os.path.join(tmp, "full.png")
        crop = os.path.join(tmp, "crop.png")
        run(["grim", "-g", f"{x},{y} {width}x{height}", full], timeout=4, check=True)
        run(
            ["ffmpeg", "-y", "-i", full, "-vf", "crop=iw:230:0:ih-230", crop],
            timeout=4,
            check=True,
        )
        text = run(["tesseract", crop, "stdout", "--psm", "6"], timeout=8)
    return text.stdout.decode("utf-8", "replace")


def shutil_which(name):
    """Find program `name` on the PATH (a small copy of shutil.which)."""
    for directory in os.environ.get("PATH", "").split(":"):
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def draft_in_composer(text, agent=None):
    """Given the OCR text from composer_text(), return any half-typed draft.

    Returns "" if the prompt box looks empty, None if it could not be read.
    For terminal agents, the prompt box is the LAST line starting with ">".
    Grey hint text (PLACEHOLDERS) does not count as a draft. Grok Bot has no
    ">" prompt, so there a line counts only if it is mostly real words.
    """
    if text is None:
        return None
    if agent == "grok-bot":
        # Grok Bot has no ">" prompt. OCR of the bottom bar is noisy, so only
        # a line that is mostly words counts as a draft.
        lines = []
        for raw in text.splitlines():
            line = " ".join(raw.split())
            letters = sum(ch.isalpha() for ch in line)
            marks = sum(not ch.isalnum() and not ch.isspace() for ch in line)
            if letters >= 36 and marks <= 4:
                lines.append(line)
        return lines[-1][:160] if lines else ""
    # The composer is the last ">" prompt. Status lines sit under it and
    # older turns sit above it, so only that prompt counts as a draft.
    prompts = []
    for raw in text.splitlines():
        line = " ".join(raw.split())
        stripped = line.lstrip()
        if stripped.startswith(">"):
            prompts.append(stripped.lstrip(">").strip())
    if not prompts:
        return ""
    body = prompts[-1]
    low = body.lower()
    if not body or any(holder in low for holder in PLACEHOLDERS) or "to do anything" in low:
        return ""
    return body


# -----------------------------------------------------------------------------
# SECTION 6: Small helpers - reading the message text, working out who is
# sending, and checking URLs and desktop numbers before using them
# -----------------------------------------------------------------------------

def read_message(args):
    """The message text: from the command line, or piped in on standard input."""
    if args.message:
        return " ".join(args.message)
    if not sys.stdin.isatty():
        incoming = sys.stdin.read()
        if incoming.endswith("\n"):
            incoming = incoming[:-1]
        return incoming
    raise SystemExit("pass a message, or pipe one in")


def self_agent(pids):
    """Work out which agent is running this command, from its process ancestors.

    foot-claude is checked first because that window also contains a
    "claude" process.
    """
    own = os.getpid()
    found = None
    for pid in pids:
        if pid == own:
            continue
        text = cmdline(pid)
        # Prefer the foot window over the claude process it launched.
        if "OMARCHY_AGENT_CLAUDE_HOME" in text:
            return "foot-claude"
        name = command_agent(text)
        if name and found is None:
            found = name
    return found


def check_url(url):
    """Allow only http:// and https:// URLs with no control characters; else raise ValueError."""
    if not isinstance(url, str) or not url.startswith(("https://", "http://")):
        raise ValueError("only http and https URLs can be opened")
    if any(char in url for char in "\n\r\x00"):
        raise ValueError("refusing a URL with a control character")
    return url


def check_desktop(number):
    """Allow only workspace numbers 1 to 20; return it as an int (or None)."""
    if number is None:
        return None
    if isinstance(number, str) and number.isdigit():
        number = int(number)
    if isinstance(number, bool) or not isinstance(number, int) or not 1 <= number <= 20:
        raise ValueError("desktop must be a workspace from 1 to 20")
    return number


def focus_desktop(number):
    """Switch the screen to workspace `number`."""
    number = check_desktop(number)
    dispatch('hl.dsp.focus({ workspace = "' + str(number) + '" })')


def host_open(url, desktop=None):
    """Open `url` in the default browser, optionally on workspace `desktop` first."""
    url = check_url(url)
    desktop = check_desktop(desktop)
    if desktop is not None:
        focus_desktop(desktop)
        time.sleep(0.3)
    subprocess.Popen(
        ["omarchy-launch-browser", url],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    where = f" on desktop {desktop}" if desktop is not None else ""
    print(f"opened {url}{where}", flush=True)


# -----------------------------------------------------------------------------
# SECTION 7: The files on disk
#   inbox/*.msg   = waiting to be delivered by the host service
#   talk/*.jsonl  = the permanent record of every message
# -----------------------------------------------------------------------------

def enqueue_action(url, desktop):
    """From the sandbox: ask the host service to open a URL or switch desktop.

    Writes a small JSON file into the inbox, e.g.
    {"do": "open", "url": "https://...", "desktop": 2}
    """
    if url:
        check_url(url)
    desktop = check_desktop(desktop)
    if not url and desktop is None:
        raise SystemExit("pass --open, --desktop, or a message")
    payload = {"do": "open" if url else "desktop"}
    if url:
        payload["url"] = url
    if desktop is not None:
        payload["desktop"] = desktop
    inbox = INBOXES[0]
    inbox.mkdir(parents=True, exist_ok=True)
    path = inbox / f"{time.time_ns()}-{os.getpid()}.msg"
    path.write_text(json.dumps(payload), encoding="utf-8")
    print("queued for the host")


def seat_name(name):
    """Return `name` if it is a known seat, otherwise None."""
    return name if name in AGENTS else None


def resolve_sender(sender, self_window, pids):
    """Decide what name to sign a message with.

    Order: --from if given, then the agent that owns our window, then the
    agent found in our process ancestors, else "unknown".
    """
    named = seat_name(sender)
    if named:
        return named
    window_agent = (self_window or {}).get("agent")
    if window_agent in AGENTS:
        return window_agent
    return self_agent(pids) or sender or "unknown"


def enqueue(target, message, wake=False, sender=None, private=False):
    """From the sandbox: queue a message for the host service to deliver.

    target: a seat name, or "*" for everyone. wake=True means "type it into
    the window too", False means a quiet note (file only). private=True
    keeps it out of the public GitHub repo.
    """
    origin = seat_name(sender) or self_agent(ancestors()) or "unknown"
    inbox = INBOXES[0]
    inbox.mkdir(parents=True, exist_ok=True)
    path = inbox / f"{time.time_ns()}-{os.getpid()}.msg"
    payload = {"from": origin, "to": target, "message": message}
    if wake:
        payload["wake"] = True
    if private:
        payload["private"] = True
    path.write_text(json.dumps(payload), encoding="utf-8")
    print(f"queued for {target}")


def file_message(sender, recipient, message, quiet=False, private=False):
    """Write one message permanently into the talk files.

    Appends the same JSON line to talk/log.jsonl (everything) and to
    talk/for-<recipient>.jsonl (that seat's mailbox). If GitHub sync is set
    up, it also writes the message as a file into the PUBLIC repo, or the
    private one when private=True or the text looks like it holds a secret.
    The caller then pushes it (see push_soon and SECTION 11).
    """
    if recipient not in AGENTS:
        raise ValueError(f"no such agent {recipient}")
    text = str(message).strip()
    if not text:
        raise ValueError("refusing to file an empty message")
    record = {
        # id: time in nanoseconds first, so ids sort in sending order; then
        # machine and process, so two senders can never pick the same id.
        "id": f"{time.time_ns()}-{HOST}-{os.getpid()}",
        "host": HOST,
        "from": sender if sender in AGENTS else "unknown",
        "to": recipient,
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "message": text,
        "quiet": bool(quiet),
        "private": keep_private(text, private),
    }
    append_local(record)
    export_message(record)
    print(f"filed for {recipient}", flush=True)
    return record


def note_untyped(agent, ids):
    """Remember that a note could not be typed into `agent`'s window.

    `ids` maps seat -> message id (from file_seats). The id is added to
    talk/untyped-<agent>, one per line. The scheduler reminds the agent
    about these notes as well as quiet ones, so a note that couldn't be
    typed (say, because someone was mid-sentence in that window) is never
    silently missed.
    """
    message_id = ids.get(agent)
    if agent not in NUDGED or not message_id:
        return
    TALK.mkdir(parents=True, exist_ok=True)
    with open(TALK / f"untyped-{agent}", "a", encoding="utf-8") as handle:
        handle.write(message_id + "\n")


def looks_secret(text):
    """True if `text` matches any SECRET_PATTERNS (a password, key, token or code)."""
    return any(pattern.search(text) for pattern in SECRET_PATTERNS)


def keep_private(text, private):
    """Decide whether a note must stay out of the public repo.

    True if the sender asked (--private), or if the text looks like it
    contains a secret, in which case it warns so the sender knows why.
    """
    if private:
        return True
    if looks_secret(text):
        print("this looks like it contains a password, key, token or code: "
              "keeping it in the PRIVATE repo, not the public one", file=sys.stderr, flush=True)
        return True
    return False


def repo_for(private):
    """The git clone a note should be written to, or None if there is none.

    Public notes go to PUBLIC_REPO. Private notes go to SYNC_REPO, and are
    never put in the public repo, even if the private clone is missing. A
    public note falls back to the private clone if there is no public one.
    """
    public, secret = PUBLIC_REPO, SYNC_REPO
    if not private and (public / ".git").exists():
        return public
    if (secret / ".git").exists():
        return secret
    return None


def sync_repos():
    """Every git clone that exists on this machine (public first)."""
    return [repo for repo in (PUBLIC_REPO, SYNC_REPO) if (repo / ".git").exists()]


def append_local(record):
    """Append one message record to this machine's talk files.

    Used both for messages sent here (file_message) and for messages
    copied in from other machines (import_remote).
    """
    TALK.mkdir(parents=True, exist_ok=True)
    line = json.dumps(record, ensure_ascii=False) + "\n"
    for name in ("log.jsonl", f"for-{record['to']}.jsonl"):
        with open(TALK / name, "a", encoding="utf-8") as handle:
            handle.write(line)


def message_text(record):
    """Turn a message record into the plain-text form stored on GitHub.

    Example:
        From: claude
        To: codex
        Time: 2026-11-20 23:30:00
        Machine: boop
        Quiet: no
        Visibility: public
        Id: 1795216185912303790-boop-4242

        The message itself, exactly as sent.

    Header lines first, one blank line, then the message.
    """
    return "\n".join([
        f"From: {record['from']}",
        f"To: {record['to']}",
        f"Time: {record['ts'].replace('T', ' ')}",
        f"Machine: {record['host']}",
        f"Quiet: {'yes' if record['quiet'] else 'no'}",
        f"Visibility: {'private' if record.get('private') else 'public'}",
        f"Id: {record['id']}",
        "",
        record["message"],
        "",
    ])


def parse_message_text(text):
    """Read the plain-text form back into a record (the reverse of message_text).

    Returns None if the text does not look like a message.
    """
    head, blank, body = text.partition("\n\n")
    if not blank:
        return None
    fields = {}
    for line in head.splitlines():
        key, colon, value = line.partition(":")
        if colon:
            fields[key.strip().lower()] = value.strip()
    if not fields.get("id") or not fields.get("to"):
        return None
    return {
        "id": fields["id"],
        "host": fields.get("machine", ""),
        "from": fields.get("from", "unknown"),
        "to": fields["to"],
        "ts": fields.get("time", "").replace(" ", "T"),
        "message": body.rstrip("\n"),
        "quiet": fields.get("quiet", "no") == "yes",
        "private": fields.get("visibility", "private") != "public",
    }


def export_message(record):
    """Write one message into the GitHub repo folder as plain text, if sync is set up.

    File: <repo>/messages/<YYYY-MM-DD>/<HHMMSS>-<from>-to-<to>-<id>.txt
    where <repo> is the public clone, or the private one (see repo_for)
    so a person browsing GitHub sees, per day, who wrote to whom and when.
    One file per message means two machines never edit the same file, so
    git never has a merge conflict. This only writes to disk; sync_once()
    commits and pushes. A failure is reported but never stops the message
    being filed locally.
    """
    repo = repo_for(record.get("private"))
    if repo is None:
        return
    try:
        folder = repo / "messages" / record["ts"][:10]
        folder.mkdir(parents=True, exist_ok=True)
        clock = record["ts"][11:19].replace(":", "")
        name = f"{clock}-{record['from']}-to-{record['to']}-{record['id']}.txt"
        (folder / name).write_text(message_text(record), encoding="utf-8")
    except OSError as error:
        print(f"not copied to the GitHub folder: {error}", file=sys.stderr, flush=True)


def add_commentary(author, text, private=False):
    """Add one entry to today's running commentary, then push it.

    The commentary sits beside the messages: <repo>/commentary/<date>.md,
    in the PUBLIC repo by default, or the private one with --private (or
    when the text looks like it holds a secret).
    It is a play-by-play of WHY things were done: the reasoning, the design
    choices, what was tried, what comes next. Any agent can add to it with
        relay-protocol --note "what I did and why"
    Each entry looks like:
        ### 23:40:12 · claude (boop)
        what I did and why
    Several machines may add to the same day's file. The repo's
    .gitattributes marks these files `merge=union`, which tells git to keep
    both sides' additions instead of reporting a conflict.
    """
    text = str(text).strip()
    if not text:
        raise SystemExit("refusing an empty commentary entry")
    repo = repo_for(keep_private(text, private))
    if repo is None:
        raise SystemExit(f"no commentary: neither {PUBLIC_REPO} nor {SYNC_REPO} is a git clone")
    folder = repo / "commentary"
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"{time.strftime('%Y-%m-%d')}.md"
    if not path.exists():
        path.write_text(f"# Commentary for {time.strftime('%Y-%m-%d')}\n", encoding="utf-8")
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(f"\n### {time.strftime('%H:%M:%S')} · {author} ({HOST})\n\n{text}\n")
    git(repo, "add", "commentary", timeout=30)
    print(f"added to {repo.name}/{path.relative_to(repo)}", flush=True)
    push_soon()


def push_soon():
    """Push to GitHub straight away, without making the sender wait.

    Starts `relay-protocol --sync` as a separate background process, so a
    slow connection never delays the message being typed. If a sync is
    already running, that one picks the message up (see SYNC_LOCK).
    """
    if not sync_repos():
        return
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--sync"],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def read_unread(agent):
    """Print `agent`'s new messages, then mark them as read.

    The cursor file holds how many characters of for-<agent>.jsonl have
    already been read. Everything after that point is new. After printing,
    the cursor moves to the end of the file.
    """
    TALK.mkdir(parents=True, exist_ok=True)
    path = TALK / f"for-{agent}.jsonl"
    cursor_path = TALK / f"cursor-{agent}"
    data = path.read_text(encoding="utf-8") if path.exists() else ""
    cursor = 0
    if cursor_path.exists():
        try:
            cursor = int(cursor_path.read_text().strip() or "0")
        except ValueError:
            cursor = 0
    if cursor < 0 or cursor > len(data):
        cursor = 0
    chunk = data[cursor:]
    cursor_path.write_text(str(len(data)))
    if not chunk.strip():
        print(f"no new messages for {agent}")
        return
    for line in chunk.splitlines():
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            print(line)
            continue
        print(f"{item.get('ts', '')} {item.get('from', '')}: {item.get('message', '')}")


def host_notify(message):
    """Show Neo a short desktop notification (cut to 180 characters)."""
    text = " ".join(str(message).split())
    if not text:
        raise ValueError("refusing an empty notification")
    if len(text) > 180:
        text = text[:177] + "..."
    subprocess.run(
        [
            "omarchy-notification-send",
            "-u",
            "low",
            "--transient",
            "-t",
            "8000",
            "Agents",
            text,
        ],
        check=False,
    )
    print("notified Neo", flush=True)


def enqueue_notify(message):
    """From the sandbox: ask the host service to show a desktop notification."""
    text = " ".join(str(message).split())
    if not text:
        raise SystemExit("refusing an empty notification")
    inbox = INBOXES[0]
    inbox.mkdir(parents=True, exist_ok=True)
    path = inbox / f"{time.time_ns()}-{os.getpid()}.msg"
    path.write_text(json.dumps({"do": "notify", "message": text}), encoding="utf-8")
    print("queued for the host")


def pending_messages():
    """Every waiting *.msg file in the inbox folders, oldest first (names start with a timestamp)."""
    found = []
    for inbox in INBOXES:
        if inbox.is_dir():
            found.extend(inbox.glob("*.msg"))
    return sorted(found)


# -----------------------------------------------------------------------------
# SECTION 8: Typing a note into a window, safely
# -----------------------------------------------------------------------------

def typed_body(window, message, sender, seat):
    """The exact text to paste into `window`.

    Terminal agents get the message as-is. The shared Grok Bot window gets
    a header saying who it is for and who sent it, plus a ready-made
    command to reply with.
    """
    if window.get("agent") != "grok-bot":
        return message
    who = sender if sender in AGENTS else "the agents"
    back = who if who in AGENTS else "grok"
    if seat in BOTS:
        label = seat
        reply_as = seat
    else:
        label = "Ava, Ruth, Creative, Harkiver, Logistics, Health, Research, Communications, and Finance"
        reply_as = "ruth"
    hint = f'relay-protocol --from {reply_as} --to {back} "{reply_as.title()} here. <reply>"'
    return f"[relay-protocol for {label}, from {who}]\n{message}\n\n(Reply with: {hint})"


def type_into(target, message, submit, force):
    """Paste `message` into `target`'s prompt box and (usually) send it.

    Steps: take the lock so only one copy types at once; remember the
    focused window and the clipboard; focus the target; read its prompt
    box and refuse if there is a draft (unless force); copy the message to
    the clipboard; press Ctrl+Shift+V; press Enter or Tab (unless submit
    is "none"); then always restore the clipboard and the focus.
    """
    lock_file = open(LOCK_PATH, "a")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise RuntimeError("another relay-protocol send is already running")

    # Remember where you were, and what was on your clipboard, so both can be put back.
    previous = active_address()
    saved_clip = clipboard_snapshot()
    copier = None
    focused = False
    try:
        focus(target["address"])
        focused = True
        fresh = next(w for w in agent_windows() if w["address"] == target["address"])
        # Screenshot the bottom of the window and read it; stop if someone has typed something.
        draft = draft_in_composer(composer_text(fresh), fresh.get("agent"))
        if draft and not force:
            raise RuntimeError(f"composer has text: {draft}")
        copier = copy_text(message.encode())
        time.sleep(0.08)
        # Paste. Terminals use Ctrl+Shift+V rather than Ctrl+V.
        tap("CTRL SHIFT", "V")
        time.sleep(0.12)
        how = "pasted"
        if submit != "none":
            key = submit_key(fresh["agent"], fresh.get("title") or "", submit)
            tap("", key)
            how = "queued" if key == "Tab" else "sent"
        print(f"{how} to {fresh['agent']}", flush=True)
    finally:
        if copier is not None and copier.poll() is None:
            copier.terminate()
        # Always runs, even after an error: put the clipboard back, then the focus.
        restore_clipboard(saved_clip)
        if focused and previous and previous != target["address"]:
            try:
                focus(previous)
            except RuntimeError as error:
                print(f"could not restore focus: {error}", file=sys.stderr)
        lock_file.close()


